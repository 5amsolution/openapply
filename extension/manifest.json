{
  "manifest_version": 3,
  "name": "5AM Apply Autofill",
  "version": "1.2.0",
  "description": "Fill job application forms with your 5AM Apply profile and the tailored answers written for that job. You always review and submit.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "5AM Apply",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "minimum_chrome_version": "110"
}
