# --- Required ---------------------------------------------------------------
# From Supabase → Project settings → API (or run scripts/setup-supabase.mjs)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://openapply.example.com

# Encrypts users' AI keys at rest. Generate once, back it up, never change it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=

# Protects /api/cron/autopilot (also enables the built-in hourly scheduler)
CRON_SECRET=

# --- Optional -----------------------------------------------------------------
# AUTOPILOT_SCHEDULER=off          # turn off the built-in scheduler (use scripts/cron.mjs instead)
# ALLOW_PRIVATE_AI_URLS=true      # self-hosting only: allow a local AI server (Ollama, LM Studio) as the custom base URL
# NEXT_PUBLIC_REPO_URL=https://github.com/you/openapply
# NEXT_PUBLIC_GOOGLE_AUTH=true     # show "Continue with Google" (enable the provider in Supabase first)
# NEXT_PUBLIC_GITHUB_AUTH=true

# Extra job sources (all have free tiers)
# ADZUNA_APP_ID=                   # https://developer.adzuna.com — local jobs in 19 countries
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us                # gb, de, fr, in, au, ca, …
# USAJOBS_API_KEY=                 # https://developer.usajobs.gov
# USAJOBS_EMAIL=
# RAPIDAPI_JSEARCH_KEY=            # https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch — LinkedIn, Indeed, Glassdoor
# JSEARCH_MONTHLY_LIMIT=180        # requests/month across all users (free plan ≈ 200); results are cached 24h
#                                  # Users can also add their own free JSearch key in Settings (their quota, private results)

# Company career boards to scan (comma-separated board names; defaults to a list of well-known companies)
# GREENHOUSE_BOARDS=anthropic,stripe,airbnb
# LEVER_COMPANIES=spotify,plaid
# ASHBY_BOARDS=openai,notion,linear
